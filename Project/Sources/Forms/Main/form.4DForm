{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "fixed",
  "windowSizingY": "fixed",
  "windowMinWidth": 640,
  "windowMinHeight": 380,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": [
    "onLoad"
  ],
  "windowTitle": ":xliff:Main_WindowTitle",
  "destination": "detailScreen",
  "method": "method.4dm",
  "pages": [
    {
      "objects": {}
    },
    {
      "objects": {
        "lblTitle": {
          "type": "text",
          "text": ":xliff:Main_Title",
          "top": 16,
          "left": 20,
          "width": 400,
          "height": 26,
          "fontSize": 16,
          "fontWeight": "bold"
        },
        "lblSubtitle": {
          "type": "text",
          "text": ":xliff:Main_Subtitle",
          "top": 46,
          "left": 20,
          "width": 400,
          "height": 40,
          "fontTheme": "additional"
        },
        "lblLanguage": {
          "type": "text",
          "text": ":xliff:Main_Language",
          "top": 20,
          "left": 430,
          "width": 90,
          "height": 17,
          "textAlign": "right"
        },
        "dropLanguage": {
          "type": "dropdown",
          "top": 16,
          "left": 530,
          "width": 90,
          "height": 22,
          "dataSource": "Form.languageDrop",
          "dataSourceTypeHint": "object",
          "events": [
            "onDataChange"
          ],
          "method": "ObjectMethods/dropLanguage.4dm"
        },
        "btnLogin": {
          "type": "button",
          "text": ":xliff:Main_TileLogin",
          "top": 100,
          "left": 20,
          "width": 290,
          "height": 40,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnLogin.4dm"
        },
        "lblLoginCaption": {
          "type": "text",
          "text": ":xliff:Main_CaptionLogin",
          "top": 144,
          "left": 20,
          "width": 290,
          "height": 36,
          "fontTheme": "additional"
        },
        "btnVersion": {
          "type": "button",
          "text": ":xliff:Main_TileVersion",
          "top": 100,
          "left": 330,
          "width": 290,
          "height": 40,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnVersion.4dm"
        },
        "lblVersionCaption": {
          "type": "text",
          "text": ":xliff:Main_CaptionVersion",
          "top": 144,
          "left": 330,
          "width": 290,
          "height": 36,
          "fontTheme": "additional"
        },
        "btnPages": {
          "type": "button",
          "text": ":xliff:Main_TilePages",
          "top": 196,
          "left": 20,
          "width": 290,
          "height": 40,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnPages.4dm"
        },
        "lblPagesCaption": {
          "type": "text",
          "text": ":xliff:Main_CaptionPages",
          "top": 240,
          "left": 20,
          "width": 290,
          "height": 36,
          "fontTheme": "additional"
        },
        "btnURL": {
          "type": "button",
          "text": ":xliff:Main_TileURL",
          "top": 196,
          "left": 330,
          "width": 290,
          "height": 40,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnURL.4dm"
        },
        "lblURLCaption": {
          "type": "text",
          "text": ":xliff:Main_CaptionURL",
          "top": 240,
          "left": 330,
          "width": 290,
          "height": 36,
          "fontTheme": "additional"
        },
        "lblComponent": {
          "type": "text",
          "text": ":xliff:Main_Component",
          "top": 292,
          "left": 20,
          "width": 600,
          "height": 32,
          "fontTheme": "additional"
        },
        "statusLine": {
          "type": "input",
          "dataSource": "Form.status",
          "dataSourceTypeHint": "text",
          "top": 336,
          "left": 20,
          "width": 600,
          "height": 17,
          "enterable": false,
          "focusable": false,
          "class": "statusLine"
        }
      }
    }
  ]
}
