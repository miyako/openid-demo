{
  "$4d": {
    "version": "1",
    "kind": "form"
  },
  "windowSizingX": "fixed",
  "windowSizingY": "fixed",
  "windowMinWidth": 640,
  "windowMinHeight": 470,
  "windowMaxWidth": 32767,
  "windowMaxHeight": 32767,
  "rightMargin": 20,
  "bottomMargin": 20,
  "events": [
    "onLoad",
    "onUnload",
    "onTimer"
  ],
  "windowTitle": ":xliff:VersionLab_WindowTitle",
  "destination": "detailScreen",
  "method": "method.4dm",
  "pages": [
    {
      "objects": {}
    },
    {
      "objects": {
        "lblExplain": {
          "type": "text",
          "text": ":xliff:VersionLab_Explain",
          "top": 16,
          "left": 20,
          "width": 600,
          "height": 30,
          "fontTheme": "additional"
        },
        "btnRunVersion": {
          "type": "button",
          "text": ":xliff:VersionLab_Run",
          "top": 56,
          "left": 20,
          "width": 200,
          "height": 28,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnRunVersion.4dm"
        },
        "btnRunDispose": {
          "type": "button",
          "text": ":xliff:VersionLab_RunDispose",
          "top": 92,
          "left": 20,
          "width": 200,
          "height": 28,
          "events": [
            "onClick"
          ],
          "method": "ObjectMethods/btnRunDispose.4dm"
        },
        "lblCompiled": {
          "type": "text",
          "text": ":xliff:VersionLab_Compiled",
          "top": 60,
          "left": 240,
          "width": 80,
          "height": 17,
          "textAlign": "right"
        },
        "inpCompiled": {
          "type": "input",
          "dataSource": "Form.compiled",
          "dataSourceTypeHint": "text",
          "top": 58,
          "left": 330,
          "width": 120,
          "height": 22,
          "enterable": false,
          "focusable": false
        },
        "lblVersion": {
          "type": "text",
          "text": ":xliff:VersionLab_Version",
          "top": 94,
          "left": 240,
          "width": 80,
          "height": 17,
          "textAlign": "right"
        },
        "inpVersion": {
          "type": "input",
          "dataSource": "Form.version",
          "dataSourceTypeHint": "text",
          "top": 92,
          "left": 330,
          "width": 120,
          "height": 22,
          "enterable": false,
          "focusable": false
        },
        "spinBusy": {
          "type": "spinner",
          "dataSource": "Form.busy",
          "top": 62,
          "left": 470,
          "width": 24,
          "height": 24
        },
        "statusLine": {
          "type": "input",
          "dataSource": "Form.status",
          "dataSourceTypeHint": "text",
          "top": 132,
          "left": 20,
          "width": 600,
          "height": 17,
          "enterable": false,
          "focusable": false,
          "class": "statusLine"
        },
        "inpLog": {
          "type": "input",
          "dataSource": "Form.log",
          "dataSourceTypeHint": "text",
          "top": 160,
          "left": 20,
          "width": 600,
          "height": 240,
          "enterable": false,
          "focusable": false,
          "multiline": "automatic",
          "wordwrap": "normal",
          "verticalScrollBar": true
        },
        "lblNotes": {
          "type": "text",
          "text": ":xliff:VersionLab_Notes",
          "top": 412,
          "left": 20,
          "width": 600,
          "height": 36,
          "fontTheme": "additional"
        }
      }
    }
  ]
}
